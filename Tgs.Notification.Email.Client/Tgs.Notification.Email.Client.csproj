<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.1</Version>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.Notification.Email.Client</RootNamespace>
		<PackageId>Tgs.Notification.Email.Client</PackageId>
		<Title>Tgs.Notification.Email.Client</Title>
